# Touchstone Phase 0 spike. Copy to .env and fill in. Never commit the real .env.

# The funder wallet. Generate with `npm run wallets`, then fund its address with
# Arc testnet USDC at https://faucet.circle.com (select Arc Testnet).
FUNDER_ADDRESS=
FUNDER_PRIVATE_KEY=

# Three source (seller) wallets that receive attribution splits. Auto-generated
# by `npm run wallets`. They only receive, so they need no gas.
SOURCE_A_ADDRESS=
SOURCE_A_PRIVATE_KEY=
SOURCE_B_ADDRESS=
SOURCE_B_PRIVATE_KEY=
SOURCE_C_ADDRESS=
SOURCE_C_PRIVATE_KEY=

# The attribution verifier. With a key, Gemini scores which sources an answer
# actually used. Without it, a transparent overlap heuristic runs.
GEMINI_API_KEY=
ASSAY_JUDGE_MODEL=gemini-2.5-flash
