# Cobo Agentic Wallet credentials for the Phase 0 spike.
# Copy to .env and fill in. Never commit the real .env.

# Your CAW API endpoint, for example https://api.agenticwallet.cobo.com
CAW_API_URL=

# Your agent runtime API key (owner key for the spike).
CAW_API_KEY=

# Your wallet UUID.
CAW_WALLET_ID=

# The address you will treat as the legit, allowlisted supplier.
# Operations A and C both send here. Use a real Base Sepolia address you control.
SUPPLIER_ADDRESS=

# Optional. A different, non-allowlisted address used to prove an address denial.
# Defaults to a throwaway address if unset.
WRONG_ADDRESS=
