# Assay configuration. Copy to .env.local. The app runs fully in demo mode with
# none of these set: a mock CAW client (faithful to the testnet behavior the
# Phase 0 spike observed) and a transparent heuristic judge.

# --- The intent judge (optional) ---
# With a key set, conformance is decided by a model. Without any key, a
# transparent heuristic is used so the demo always runs.
# Gemini has a free tier and is preferred when both keys are present.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Force a provider when both keys are set: gemini or claude.
ASSAY_JUDGE_PROVIDER=
# Optional model override (defaults: gemini-2.5-flash / claude-sonnet-4-6).
ASSAY_JUDGE_MODEL=

# --- Live CAW (optional) ---
# Set CAW_MODE=live plus the values below to route operations to a real active
# pact on the testnet instead of the mock.
CAW_MODE=
CAW_API_URL=https://api.agenticwallet.cobo.com
CAW_API_KEY=
CAW_WALLET_ID=
CAW_PACT_ID=
CAW_SRC_ADDRESS=
